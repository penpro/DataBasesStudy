{
  "name": "cs330-study-db",
  "version": "1.0.0",
  "private": true,
  "description": "CS 330 final project: a database-backed study tool (MySQL + Express) for the course's question bank",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "import": "node scripts/import-bank.js",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "db:reset": "node scripts/reset-db.js --yes",
    "build:demo": "node scripts/build-demo-bank.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.24.6"
  }
}
